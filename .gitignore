# Subprojects with their own git repos — exclude them here
Booksmut/
Rapid2/
model-skills/
model-specific-skills/
Architect/
Sportsball/
Gemini/

# Personal journal — moved to builds-journal private repo
Build Log.md
tasks.md
claude-code-confirmed.md
claude-code-to-investigate.md
memory/
"temp context"/

# Claude/Gemini local config that must never be committed
.claude/settings.local.json
.claude/scheduled_tasks.lock
.qwen

# Claude Desktop Skills folder on Desktop (ephemeral output)
# Never commit secrets or credentials
*.env
.env.*
!.env.example
*credentials*.json

# Windows / OS noise
Thumbs.db
Desktop.ini
.DS_Store

# LibreOffice lock files (created when a file is open, never commit)
.~lock.*

# Claude Code agent worktrees (ephemeral — never commit)
.claude/worktrees/

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# VS Code user settings (keep workspace file, exclude user-specific)
.vscode/settings.json
HF Agents Course/
FinancialManager/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
